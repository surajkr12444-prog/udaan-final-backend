{
  "name": "udaan-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API for Udaan.AI scheme matching platform",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seedSchemes.js",
    "seed:schemes": "node src/scripts/seedSchemes.js",
    "seed:scholarships": "node src/scripts/seedScholarships.js",
    "seed:all": "node src/scripts/seedSchemes.js && node src/scripts/seedScholarships.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.0"
  }
}
